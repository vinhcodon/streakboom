{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Streakboom",
  "version": "0.6.0",
  "identifier": "com.streakboom.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Streakboom",
        "width": 200,
        "height": 200,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Streakboom",
    "shortDescription": "A small desktop pet that lives on your screen",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2MTMxNTVEMzFFMEE1RTkKUldUcHBlQXhYUlVURmpNSkFmVGYwZGU1c0NBWmpTWG5NSHA3cnRjbXFaV1RraUZsM0c1M3Q3RmkK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
